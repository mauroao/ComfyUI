e":"scale_stick_for_xinsr_cn"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[12]},{"localized_name":"POSE_KEYPOINT","name":"POSE_KEYPOINT","type":"POSE_KEYPOINT","links":[16]}],"properties":{"cnr_id":"comfyui_controlnet_aux","ver":"a587a4c1594524c1d2de5cd1a86cd868ff448e1c","Node name for S&R":"DWPreprocessor","aux_id":"Fannovel16/comfyui_controlnet_aux"},"widgets_values":["enable","enable","enable",1024,"yolox_l.torchscript.pt","dw-ll_ucoco_384_bs5.torchscript.pt","disable"],"widgets_values_named":{"detect_hand":"enable","detect_body":"enable","detect_face":"enable","resolution":1024,"bbox_detector":"yolox_l.torchscript.pt","pose_estimator":"dw-ll_ucoco_384_bs5.torchscript.pt","scale_stick_for_xinsr_cn":"disable"}},{"id":10,"type":"PreviewImage","pos":[850,460],"size":[320,420],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":12}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Detected skeleton","properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"PreviewImage"}},{"id":12,"type":"SaveImage","pos":[1680,0],"size":[360,460],"flags":{},"order":12,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":14},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"SaveImage"},"widgets_values":["pose/skeleton"],"widgets_values_named":{"filename_prefix":"pose/skeleton"}},{"id":14,"type":"MarkdownNote","pos":[-855,-878.3333333333334],"size":[760,520],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"properties":{"Node name for S&R":"MarkdownNote"},"widgets_values":["# Pose from text\n\nGenerates an OpenPose skeleton from a natural-language description, lets you fix it by hand, and saves it for `qwen_image_edit_2511_venera_lora_pose.json`.\n\nOnly the **pose and framing** of the reference photo matter: clothing, face and background are discarded by DWPose. Keep the reference SDXL prompt generic.\n\n## Steps\n\n1. Write the pose/framing in the **positive prompt** and queue. 4 candidates appear in *Candidates*.\n2. Set `batch_index` (0-3) in **Pick candidate** to the best one. Set the KSampler seed to `fixed` and queue again. DWPose extracts the skeleton, and it loads into **OpenPose Studio**.\n3. Click the OpenPose Studio preview (or its pencil button) to open the editor. Drag keypoints, then click **Apply**.\n4. **Delete the link going into OpenPose Studio's `pose_keypoint` input.** While that link is connected, DWPose overwrites your edits on every queue. Queue again to render the edited skeleton.\n5. Copy the JSON shown in **Pose JSON** (or export it/save it to the gallery from the editor). Paste it into the **Pose (Picture 2)** node of the final workflow. The rendered PNG is also saved to `output/pose/`.\n\n## Tips\n\n- Keep the latent aspect ratio close to Picture 1 of the final workflow (896x1152 ≈ 846x1080). The skeleton's framing becomes the output framing.\n- To redo the detection, reconnect DWPose `POSE_KEYPOINT` → OpenPose Studio `pose_keypoint`.\n- DWPose models download from HuggingFace on first run (torchscript, GPU, no onnxruntime needed).\n"],"widgets_values_named":{"text":"# Pose from text\n\nGenerates an OpenPose skeleton from a natural-language description, lets you fix it by hand, and saves it for `qwen_image_edit_2511_venera_lora_pose.json`.\n\nOnly the **pose and framing** of the reference photo matter: clothing, face and background are discarded by DWPose. Keep the reference SDXL prompt generic.\n\n## Steps\n\n1. Write the pose/framing in the **positive prompt** and queue. 4 candidates appear in *Candidates*.\n2. Set `batch_index` (0-3) in **Pick candidate** to the best one. Set the KSampler seed to `fixed` and queue again. DWPose extracts the skeleton, and it loads into **OpenPose Studio**.\n3. Click the OpenPose Studio preview (or its pencil button) to open the editor. Drag keypoints, then click **Apply**.\n4. **Delete the link going into OpenPose Studio's `pose_keypoint` input.** While that link is connected, DWPose overwrites your edits on every queue. Queue again to render the edited skeleton.\n5. Copy the JSON shown in **Pose JSON** (or export it/save it to the gallery from the editor). Paste it into the **Pose (Picture 2)** node of the final workflow. The rendered PNG is also saved to `output/pose/`.\n\n## Tips\n\n- Keep the latent aspect ratio close to Picture 1 of the final workflow (896x1152 ≈ 846x1080). The skeleton's framing becomes the output framing.\n- To redo the detection, reconnect DWPose `POSE_KEYPOINT` → OpenPose Studio `pose_keypoint`.\n- DWPose models download from HuggingFace on first run (torchscript, GPU, no onnxruntime needed).\n"},"color":"#432","bgcolor":"#653"},{"id":7,"type":"PreviewImage","pos":[300,100],"size":[500,560],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":9}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Candidates","properties":{"cnr_id":"comfy-core","ver":"0.30.0","Node name for S&R":"PreviewImage"}},{"id":13,"type":"OPS_ShowString","pos":[1676.2368404663084,526.3421167358429],"size":[360,260],"flags":{},"order":13,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","link":15}],"outputs":[],"title":"Pose JSON","properties":{"aux_id":"andreszs/ComfyUI-OpenPose-Studio","ver":"2075fbe59b88c31fc16d602ca1ff66f81abd9e43","Node name for S&R":"OPS_ShowString"}},{"id":5,"type":"KSampler","pos":[-50,0],"size":[300,470],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":1},{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":4