puts":[{"localized_name":"image","name":"image","type":"IMAGE","link":1304}],"outputs":[{"localized_name":"width","name":"width","type":"INT","links":[1305]},{"localized_name":"height","name":"height","type":"INT","links":[1306]},{"localized_name":"batch_size","name":"batch_size","type":"INT","links":[]}],"properties":{"cnr_id":"comfy-core","ver":"0.45.0","Node name for S&R":"GetImageSize"}},{"id":1181,"type":"MiniMaxH3ImageToVideo","pos":[-307.9466673637084,4957.381526389063],"size":[340,330],"flags":{},"order":23,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":1308},{"localized_name":"vae","name":"vae","type":"VAE","link":1309},{"localized_name":"first_frame","name":"first_frame","shape":7,"type":"IMAGE","link":1311},{"localized_name":"last_frame","name":"last_frame","shape":7,"type":"IMAGE","link":null},{"localized_name":"prompt","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":1310},{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":1305},{"localized_name":"height","name":"height","type":"INT","widget":{"name":"height"},"link":1306},{"localized_name":"length","name":"length","type":"INT","widget":{"name":"length"},"link":1307}],"outputs":[{"localized_name":"positive","name":"positive","type":"CONDITIONING","links":[1312]},{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[1313]}],"properties":{"cnr_id":"comfy-core","ver":"0.45.0","Node name for S&R":"MiniMaxH3ImageToVideo"},"widgets_values":["",576,768,245],"widgets_values_named":{"prompt":"","width":576,"height":768,"length":245}},{"id":1182,"type":"PrimitiveInt","pos":[1590,5320],"size":[250,82],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"INT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"INT","name":"INT","type":"INT","links":[1314]}],"title":"Steps","properties":{"cnr_id":"comfy-core","ver":"0.45.0","Node name for S&R":"PrimitiveInt"},"widgets_values":[20,"fixed"],"widgets_values_named":{"value":20,"control_after_generate":"fixed"}},{"id":1183,"type":"LoraLoaderModelOnly","pos":[151.011969739933,5808.553398716446],"size":[360,110],"flags":{},"order":22,"mode":4,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":1316},{"localized_name":"lora_name","name":"lora_name","type":"COMBO","widget":{"name":"lora_name"},"link":null},{"localized_name":"strength_model","name":"strength_model","type":"FLOAT","widget":{"name":"strength_model"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[1317]}],"title":"Optional motion/concept LoRA (fl2va, ~0.6)","properties":{"cnr_id":"comfy-core","ver":"0.45.0","Node name for S&R":"LoraLoaderModelOnly"},"widgets_values":["minimax-lora-bounceV07_fl2va-000230_Intense.safetensors",0.6],"widgets_values_named":{"lora_name":"minimax-lora-bounceV07_fl2va-000230_Intense.safetensors","strength_model":0.6}},{"id":1184,"type":"MarkdownNote","pos":[-2020,4210],"size":[450,1100],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"Note: character LoRA i2v workflow","properties":{},"widgets_values":["## MiniMax H3 i2v + character LoRA (WSL 16GB)\n\nQuality-first image-to-video with the **venera_h3_i2v_v2** character LoRA (trigger `s3xyv3n3r4`). No turbo LoRA, no upscale, no interpolation (those are done later, outside this workflow).\n\n**Why no turbo**: distilled turbo LoRAs flatten the sampling trajectory and dilute other LoRAs, so the character LoRA and the frame-0 keyframe have less say in the late frames, which is where the face/body drift shows up.\n\n**Anti-drift checklist**\n- Character LoRA at **1.0** on every step and every frame. Lower it (0.8) only if motion gets stiff or the image burns.\n- Put `s3xyv3n3r4` in the prompt as the subject's name, at the start **and** near the end of the description.\n- Don't describe permanent traits (face, hair color, piercings, breast size): the LoRA was captioned without them, so they live in the trigger. Describing them can fight the LoRA.\n- Keep the face visible and reasonably large. Fast motion, turning away, occlusion and wide shots are where likeness breaks.\n- Shorter clips drift less. 10s is the default; 5-8s is safer for close-ups.\n- The canvas follows the start image's aspect ratio (Image Scale To Total Pixels + Get Image Size), so the first frame is never stretched.\n\n**Settings**\n- Model: `minimax_h3_fl2va_pruned_int8_convrot` (the LoRA was trained on the i2v/fl2va model).\n- Sampler `res_multistep`, scheduler `simple`, **25 steps**, no CFG (BasicGuider). 20 is the official default.\n- Megapixels **0.4** (tested on the 4060 Ti). Try 0.5 for a sharper face if it doesn't OOM.\n- Optional LoRA slot (bypassed): a motion/concept fl2va LoRA at ~0.6. Each extra LoRA pulls identity away a bit.\n\nLaunch with `mauro-files/run-minimax.sh`."],"widgets_values_named":{"text":"## MiniMax H3 i2v + character LoRA (WSL 16GB)\n\nQuality-first image-to-video with the **venera_h3_i2v_v2** character LoRA (trigger `s3xyv3n3r4`). No turbo LoRA, no upscale, no interpolation (those are done later, outside this workflow).\n\n**Why no turbo**: distilled turbo LoRAs flatten the sampling trajectory and dilute other LoRAs, so the character LoRA and the frame-0 keyframe have less say in the late frames, which is where the face/body drift shows up.\n\n**Anti-drift checklist**\n- Character LoRA at **1.0** on every step and every frame. Lower it (0.8) only if motion gets stiff or the image burns.\n- Put `s3xyv3n3r4` in the prompt as the subject's name, at the start **and** near the end of the description.\n- Don't describe permanent traits (face, hair color, piercings, breast size): the LoRA was captioned without them, so they live in the trigger. Describing them can fight the LoRA.\n- Keep the face visible and reasonably large. Fast motion, turning away, occlusion and wide shots are where likeness breaks.\n- Shorter clips drift less. 10s is the default; 5-8s is safer for close-ups.\n- The canvas follows the start image's aspect ratio (Image Scale To Total Pixels + Get Image Size), so the first frame is never stretched.\n\n**Settings**\n- Model: `minimax_h3_fl2va_pruned_int8_convrot` (the LoRA was trained on the i2v/fl2va model).\n- Sampler `res_multistep`, scheduler `simple`, **25 steps**, no CFG (BasicGuider). 20 is the official default.\n- Megapixels **0.4** (tested on the 4060 Ti). Try 0.5 for a sharper face if it doesn't OOM.\n- Optional LoRA slot (bypassed): a motion/concept fl2va LoRA at ~0.6. Each extra LoRA pulls identity away a bit.\n\nLaunch with `mauro-files/run-minimax.sh`."},"color":"#432","bgcolor":"#653"}],"links":[[250,120,0,121,1,"VAE"],[251,119,0,122,1,"VAE"],[253,129,0,125,0,"NOISE"],[254,126,0,125,1,"GUIDER"],[255,123,0,125,2,"SAMPLER"],[256,124,0,125,3,"SIGMAS"],[258,122,0,130,0,"IMAGE"],[259,121,0,130,1,"AUDIO"],[280,125,0,122,0,"LATENT"],[281,125,0,121,0,"LATENT"],[334,172,0,124,0,"MODEL"],[337,127,0,172,0,"MODEL"],[1254,1133,0,1135,0,"INT"],[1272,1152,0,1155,0,"STRING"],[1292,1171,0,1151,0,"STRING"],[1293,1135,0,1171,1,"STRING"],[1294,1171,0,1172,0,"STRING"],[1298,1133,0,129,0,"INT"],[1299,132,0,1171,0,"FLOAT"],[1303,164,0,1179,0,"IMAGE"],[1304,1179,0,1180,0,"IMAGE"],[1305,1180,0,1181,5,"INT"],[1306,1180,1,1181,6,"INT"],[1307,131,1,1181,7,"INT"],[1308,128,0,1181,0,"CLIP"],[1309,119,0,1181,1,"VAE"],[1310,138,0,1181,4,"STRING"],[1311,164,0,1181,2,"IMAGE"],[1312,1181,0,126,1,"CONDITIONING"],[1313,1181,1,125,4,"LATENT"],[1314,1182,0,124,2,"INT"],[1315,172,0,173,0,"MODEL"],[1316,173,0,1183,0,"MODEL"],[1317,1183,0,126,0,"MODEL"],[261,132,0,131,0,"FLOAT"],[1295,130,0,1092,0,"VIDEO"],[1271,1155,0,1092,1,"STRING"]],"groups":[{"id":1,"title":"Models","bounding":[-2117.592098615769,5522.41162229026,700,990],"color":"#3f789e","flags":{}},{"id":2,"title":"Sampling","bounding":[1170,4840,690,700],"color":"#3f789e","flags":{}},{"id":4,"title":"Decoding and create video","bounding":[1170,5570,690,260]